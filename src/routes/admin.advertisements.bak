      </div>

      {/* Active Tab Info & Rotation Settings Bar */}
      {!isTrash && activeSlot && (
        <div className="rounded-xl border border-slate-200 bg-white p-4 shadow-xs">
          <div className="flex flex-wrap items-center justify-between gap-3">
            <div className="flex flex-wrap items-center gap-2 text-xs">
              <span className="rounded-md bg-slate-900 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-white">
                {activeSlot.label}
              </span>
              <span className="rounded-md bg-indigo-50 px-2.5 py-1 text-[11px] font-bold text-indigo-700 border border-indigo-100">
                {activeSlot.orientation} ({activeSlot.size})
              </span>
              <span className="text-slate-600 font-medium">
                <strong>Where:</strong> {activeSlot.shownOn}
              </span>
            </div>

            <div className="flex items-center gap-3">
              <button
                type="button"
                onClick={() => setShowDemoGuide((v) => !v)}
                className="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 transition"
              >
                {showDemoGuide ? <EyeOff className="h-3.5 w-3.5" /> : <Eye className="h-3.5 w-3.5" />}
                {showDemoGuide ? "Hide guide" : "View preview guide"}
              </button>

              <div
                className={`flex items-center gap-2 rounded-lg border px-3 py-1.5 transition-colors ${
                  hasScriptAdActive
                    ? "border-slate-200 bg-slate-100 text-slate-400 cursor-not-allowed"
