                  min={1}
                  max={120}
                  value={rotation}
                  onChange={(e) => setRotation(Math.max(1, Number(e.target.value) || 1))}
                  className={`w-14 rounded border px-2 py-0.5 text-xs font-bold text-center focus:outline-none transition-colors ${
                    hasScriptAdActive
                      ? "border-slate-200 bg-slate-50 text-slate-400 cursor-not-allowed"
                      : "border-slate-300 bg-white text-slate-700 focus:border-slate-900"
                  }`}
                />
                <span className="text-xs text-slate-500">sec</span>
                {hasScriptAdActive && (
                  <span className="ml-1 rounded-sm bg-amber-100 px-1.5 py-0.5 text-[9px] font-bold text-amber-700 uppercase tracking-wider">
                    Disabled
                  </span>
                )}
              </div>
            </div>
          </div>

          {/* Warning notice when rotation is disabled due to script ads */}
          {hasScriptAdActive && (
            <div className="mt-3 flex items-start gap-2.5 rounded-lg bg-amber-50/70 p-3 text-xs text-amber-800 border border-amber-200/80 animate-in fade-in duration-300">
              <Info className="h-4 w-4 shrink-0 text-amber-600 mt-0.5 animate-pulse" />
              <div>
                <strong>Ad Rotation Disabled:</strong> A 3rd Party Script Ad (Google AdSense, Bing Ads, etc.) is active in this slot. Automatic slide rotation is disabled to comply with search engine/ad network policies against rapid automated refreshes, which can lead to account suspension.
              </div>
            </div>
          )}

          {/* Optional Visual Preview Guide */}
          {showDemoGuide && (
            <div className="mt-3.5 pt-3.5 border-t border-slate-100 flex flex-wrap items-center gap-4 text-xs text-slate-600 bg-slate-50/70 p-3 rounded-lg">
              <div className="font-semibold text-slate-900">Ad Types Supported:</div>
              <div className="flex items-center gap-2">
                <span className="inline-block h-3 w-3 rounded-full bg-indigo-600" />
                <span>Custom Image Banner (Portrait / Landscape)</span>
              </div>
              <div className="flex items-center gap-2">
                <span className="inline-block h-3 w-3 rounded-full bg-purple-600" />
                <span>Google AdSense / Bing / 3rd Party JS &amp; HTML Script</span>
              </div>
            </div>
          )}
        </div>
      )}

      {/* Integration Mode Switcher for Active Tab */}
      {!isTrash && (
        <div className="flex items-center gap-2 border-b border-slate-200 pb-4">
          <button
            type="button"
            onClick={() => { setSlotMode("image"); saveAdSlotMode(slot, "image"); }}
            className={`rounded-lg px-4 py-2 text-sm font-semibold transition ${
              slotMode === "image"
                ? "bg-slate-900 text-white"
                : "bg-slate-100 text-slate-600 hover:bg-slate-200"
            }`}
          >
            Custom Banner Slideshow
          </button>
          <button
            type="button"
            onClick={() => { setSlotMode("script"); saveAdSlotMode(slot, "script"); }}
            className={`rounded-lg px-4 py-2 text-sm font-semibold transition ${
              slotMode === "script"
                ? "bg-slate-900 text-white"
                : "bg-slate-100 text-slate-600 hover:bg-slate-200"
            }`}
          >
            Google AdSense / 3rd Party Script
          </button>
        </div>
      )}

      {/* Main Tab Content */}
      {isTrash ? (
        trash.length === 0 ? (
          <div className="flex flex-col items-center justify-center rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center">
            <Trash className="mb-3 h-8 w-8 text-slate-400" />
            <h3 className="text-base font-semibold text-slate-800">Trash is empty</h3>
            <p className="mt-1 text-xs text-slate-500">Deleted ad slides will appear here and can be restored within 30 days.</p>
          </div>
        ) : (
          <div className="space-y-3">
            <div className="flex items-center justify-between rounded-lg bg-amber-50 px-4 py-2 text-xs text-amber-800 border border-amber-200">
              <div className="flex items-center gap-2 font-medium">
                <Info className="h-4 w-4 shrink-0 text-amber-600" />
                Items in trash are automatically purged 30 days after deletion.
              </div>
            </div>
            {trash.map((ad) => (
              <div
                key={ad.id}
                className="flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-4 sm:flex-row sm:items-center sm:justify-between shadow-xs hover:border-slate-300 transition"
              >
                <div className="flex items-center gap-3">
                  <div className="relative h-16 w-16 shrink-0 overflow-hidden rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center">
                    {ad.type === "script" ? (
                      <Code className="h-6 w-6 text-purple-600" />
